/* 
|||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||

DDL SCRIPT TO CREATE BRONZE TABLES

|||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||

Goal:
    - Create tables in the Bronze layer.
    - Drop existing tables if they already exist.
    - Define the structure of the Bronze layer tables.

TAKE CARE:
    This script drops existing tables before recreating them.
*/



/**************************************************************/
/******* Create Customer Table from CRM ***********************/

IF OBJECT_ID ('bronze.crm_customers_info' , 'U') IS NOT NULL
	DROP TABLE bronze.crm_customers_info;

CREATE TABLE  bronze.crm_customers_info (
	cst_id INT,
	cst_key NVARCHAR(50),
	cst_firstname NVARCHAR(50),
	cst_lastname NVARCHAR(50),
	cst_material_status NVARCHAR(50),
	cst_gndr NVARCHAR(2),
	cst_create_date DATE
);


/**************************************************************/
/******* Create Product Table from CRM ************************/

IF OBJECT_ID ('bronze.crm_production_info' , 'U') IS NOT NULL
	DROP TABLE bronze.crm_production_info
  
CREATE TABLE  bronze.crm_product_info (
	prd_id INT,
	prd_key NVARCHAR(50),
	prd_nm NVARCHAR(50),
	prd_cost INT,
	prd_line VARCHAR(50),
	prd_start_dt DATE,
	prd_end_dt DATE
);


/**************************************************************/
/******* Create Sales Table from CRM *************************/

IF OBJECT_ID ('bronze.crm_sales_info' , 'U') IS NOT NULL
	DROP TABLE bronze.crm_sales_info
 
CREATE TABLE  bronze.crm_sales_info (
	sls_ord_num NVARCHAR(50),
	sls_prd_key NVARCHAR(50),
	sls_cust_id INT,
	sls_order_dt INT,
	sls_ship_dt INT,
	sls_due_dt INT,
	sls_sales INT,
	sls_quantity INT,
	sls_price INT
);

/**************************************************************/
/******* Create Localization Table from ERP *******************/

IF OBJECT_ID ('bronze.erp_loc_az99' , 'U') IS NOT NULL
	DROP TABLE bronze.erp_loc_az99;

CREATE TABLE bronze.erp_loc_az99(
	cid   NVARCHAR(50),
	cntry NVARCHAR(50)
);

/**************************************************************/
/******* Create Customer Table from ERP ***********************/

IF OBJECT_ID ('bronze.erp_cust_az99' , 'U') IS NOT NULL
	DROP TABLE bronze.erp_cust_az99;

CREATE TABLE bronze.erp_cust_az99(
	cid NVARCHAR(50),
	bdate DATE,
	gen NVARCHAR(50)
);

/**************************************************************/
/******* Create Category adn Subcategory Table from ERP *******/

IF OBJECT_ID ('bronze.erp_subcat' , 'U') IS NOT NULL
	DROP TABLE bronze.erp_subcat;

CREATE TABLE bronze.erp_subcat(
	id           NVARCHAR(50),
	cat          NVARCHAR(50),
	subcat       NVARCHAR(50),
	maintenance  NVARCHAR(50),
);
